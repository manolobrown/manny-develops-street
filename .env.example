# ──────────────────────────────────────────────────────────────────────────
# Contact form (Resend)
# ──────────────────────────────────────────────────────────────────────────
# Required to send personal inquiry emails. Sign up at https://resend.com,
# verify your sending domain, and paste the API key here.
RESEND_API_KEY=

# Where contact-form inquiries are delivered.
CONTACT_TO_EMAIL=hi@mannydevelops.com

# Must be a verified sender on your Resend account.
# Format: "Display Name <address@your-domain.com>"
CONTACT_FROM_EMAIL=Manuel Peña <no-reply@mannydevelops.com>

# ──────────────────────────────────────────────────────────────────────────
# Newsletter + lead-magnet forms (Kit / ConvertKit)
# ──────────────────────────────────────────────────────────────────────────
# Kit v3 API key — Settings → API Keys in your Kit account.
KIT_API_KEY=

# Form IDs — one per signup surface. Get these from each form's
# Settings → Embed → URL (the numeric path component) or the form ID
# in the dashboard URL.
KIT_FORM_NEWSLETTER_ID=
KIT_FORM_STICKY_ID=
KIT_FORM_PRESETS_ID=
KIT_FORM_PRICING_GUIDE_ID=

# ──────────────────────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────────────────────
# Used by sitemap.ts and root metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://mannydevelops.com
